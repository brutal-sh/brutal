{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "dev.jpoindexter.openpen.native-test",
  "build": {
    "beforeBuildCommand": "bun run generate:tauri-menu && vite build --mode native-test"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "incognito": true,
        "title": "Brutal Native Test",
        "width": 1280,
        "height": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 22, "y": 30 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        "default",
        "updater",
        {
          "identifier": "native-test-mcp",
          "webviews": ["main"],
          "permissions": [
            "wdio:default",
            "wdio-webdriver:default",
            {
              "identifier": "fs:allow-read-text-file",
              "allow": [
                {
                  "path": "$TEMP/openpen-native-test-*/mcp.json"
                }
              ]
            },
            {
              "identifier": "fs:allow-exists",
              "allow": [
                {
                  "path": "$TEMP/openpen-native-test-*/mcp.json"
                }
              ]
            },
            "core:app:allow-app-show",
            "core:app:allow-app-hide"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
